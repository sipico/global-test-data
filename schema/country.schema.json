{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kduvekot/ubl-examples/blob/gh-pages/schema/country.schema.json",
  "title": "Global Test Data — country file",
  "description": "One file per country (or 'global'). Every entry must cite at least one source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "name", "region", "updated", "summary", "entries"],
  "properties": {
    "code": {
      "description": "ISO 3166-1 alpha-2 code in upper case, or GLOBAL for non-country data.",
      "type": "string",
      "pattern": "^([A-Z]{2}|GLOBAL)$"
    },
    "name": {"type": "string", "minLength": 2},
    "native_name": {"type": "string"},
    "region": {
      "type": "string",
      "enum": ["Global", "Europe", "Africa", "Asia", "North America", "Latin America", "Oceania"]
    },
    "languages": {
      "description": "Languages searched during research (ISO 639-1).",
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z]{2}$"}
    },
    "updated": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "research": {
      "description": "Path of the research note that holds the evidence.",
      "type": "string"
    },
    "summary": {"type": "string", "minLength": 20},
    "identifiers": {
      "description": "Identifier types used in this country and how to validate them.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "format"],
        "properties": {
          "name": {"type": "string"},
          "format": {"type": "string"},
          "check": {"type": "string", "description": "Name of a validator in tools/checks.py"},
          "authority": {"type": "string"},
          "notes": {"type": "string"},
          "ubl": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "type", "value", "label", "status", "sources"],
      "properties": {
        "id": {
          "description": "Unique id, starting with the lower-case country code (or 'global-').",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)+$"
        },
        "category": {
          "type": "string",
          "enum": ["organisation", "address", "contact", "banking", "trade", "person", "document", "other"]
        },
        "type": {"type": "string", "minLength": 2, "description": "e.g. SIREN, VAT number, Postcode, Phone range"},
        "value": {"type": "string", "minLength": 1},
        "kind": {
          "description": "value = one usable value (default); range = a pattern or range of values; placeholder = text placeholder",
          "type": "string",
          "enum": ["value", "range", "placeholder"]
        },
        "label": {"type": "string", "minLength": 3, "description": "What it is, in a few words"},
        "status": {
          "type": "string",
          "enum": ["reserved", "published-example", "derived", "avoid"]
        },
        "checks": {
          "description": "Validators in tools/checks.py that the value MUST pass.",
          "type": "array",
          "items": {"type": "string"}
        },
        "fails_checks": {
          "description": "Validators the value is known to FAIL (used for avoid entries).",
          "type": "array",
          "items": {"type": "string"}
        },
        "verified": {
          "description": "Manual verifications, each with a date, e.g. 'Not in register X (2026-11-05)'.",
          "type": "array",
          "items": {"type": "string", "minLength": 5}
        },
        "reason": {"type": "string", "description": "Why to avoid (required for status avoid)"},
        "notes": {"type": "string"},
        "ubl": {
          "description": "Where the value fits in UBL, e.g. 'cac:PartyLegalEntity/cbc:CompanyID @schemeID=0002'",
          "type": "array",
          "items": {"type": "string"}
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "url"],
            "properties": {
              "title": {"type": "string", "minLength": 3},
              "url": {"type": "string", "pattern": "^https?://"},
              "publisher": {"type": "string"},
              "accessed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
            }
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "avoid"}}},
         "then": {"required": ["reason"]}},
        {"if": {"properties": {"status": {"const": "derived"}}},
         "then": {"required": ["verified"]}}
      ]
    }
  }
}
